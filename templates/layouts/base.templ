package layouts

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Transaction Ledger</title>
			<link
				href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
				rel="stylesheet"
				integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
				crossorigin="anonymous"
			/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
		</head>
		<body class="bg-light">
			<nav class="navbar navbar-expand-lg navbar-dark bg-slate border-bottom shadow-sm">
				<div class="container">
					<a class="navbar-brand fw-semibold" href="/">Transaction Ledger</a>
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain" aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span>
					</button>
					<div class="collapse navbar-collapse" id="navMain">
						<ul class="navbar-nav ms-auto">
							<li class="nav-item"><a class="nav-link" href="/">Dashboard</a></li>
							<li class="nav-item"><a class="nav-link" href="/accounts">Accounts</a></li>
						</ul>
					</div>
				</div>
			</nav>
			<main class="container py-4">
				{ children... }
			</main>
			<aside id="json-status-panel" class="json-status-panel is-collapsed" aria-label="API JSON status window">
				<div class="json-status-header">
					<strong>API JSON (backend)</strong>
					<div class="btn-group btn-group-sm">
						<button type="button" class="btn btn-outline-light" id="clear-json-log">Clear</button>
						<button type="button" class="btn btn-outline-light" id="collapse-json-panel">Hide</button>
					</div>
				</div>
				<div id="json-status-log" class="json-status-log"></div>
			</aside>
			<button type="button" id="json-panel-fab" class="json-panel-fab is-visible" title="Show API JSON" aria-label="Show API JSON panel">
				API JSON
			</button>
			<footer class="container pb-4 text-muted small">
				<p class="mb-0">Amounts are whole rupees (₹). Example: enter <code>100</code> meaning ₹100. Default page size is 3.</p>
			</footer>
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
			<script src="/static/js/app.js"></script>
		</body>
	</html>
}
